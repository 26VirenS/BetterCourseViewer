{
 "about": "Simpl Community tools in the mock school (scripts/dev/mock-community.mjs serves it at /api/community/tools and /api/community/tools/<id> until the site’s own gallery has tools): two students’ tools, one in a later format (listed as needing a newer Simpl), then Simpl’s starters (site/src/tool-starters.js on the site’s branch), each checked by the reference (tool-format.js). The apps’ pictures browse it and add from it.",
 "ok": true,
 "tools": [
  {
   "format": 1,
   "id": "k3m9x2pa",
   "version": 2,
   "name": "Reading Time",
   "maker": "Viren",
   "summary": "How long a reading takes at your pace.",
   "group": "study",
   "symbol": "clock",
   "color": "#30b0c7",
   "inputs": [
    {
     "id": "pages",
     "kind": "number",
     "label": "Pages",
     "unit": "",
     "default": 24,
     "min": 1,
     "max": 2000,
     "step": 1
    },
    {
     "id": "words",
     "kind": "number",
     "label": "Words a page",
     "unit": "",
     "default": 300,
     "min": 50,
     "max": 1200,
     "step": 25
    },
    {
     "id": "pace",
     "kind": "choice",
     "label": "Pace",
     "options": [
      {
       "label": "Careful (150 wpm)",
       "value": 150
      },
      {
       "label": "Steady (200 wpm)",
       "value": 200
      },
      {
       "label": "Average (238 wpm)",
       "value": 238
      },
      {
       "label": "Brisk (275 wpm)",
       "value": 275
      },
      {
       "label": "Fast (325 wpm)",
       "value": 325
      },
      {
       "label": "Skimming (450 wpm)",
       "value": 450
      }
     ],
     "default": 238
    },
    {
     "id": "notes",
     "kind": "toggle",
     "label": "Taking notes (half speed)",
     "default": false
    }
   ],
   "outputs": [
    {
     "id": "mins",
     "label": "Time",
     "value": "pages * words / (pace * (notes ? 0.5 : 1))",
     "unit": "min",
     "decimals": 0
    },
    {
     "label": "Hours",
     "value": "mins / 60",
     "unit": "h",
     "decimals": 1,
     "when": "mins >= 60"
    },
    {
     "label": "Sittings of 25 min",
     "value": "ceil(mins / 25)",
     "unit": "",
     "decimals": 0
    }
   ],
   "note": "Average adult reading speed is about 238 words a minute; a textbook with notes goes slower.",
   "created": "2026-11-01"
  },
  {
