<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simpl for Windows, made again with Windows 11's own look: the Mac app's screens, steps and layouts (mac/Simpl),
       drawn with Windows 11's controls — Mica, the Settings app's navigation and cards, Fluent icons and motion — through
       WPF-UI. Underneath, as before, the student's Canvas or Brightspace runs in a web view (WebView2, the extension's own
       scripts in it) and answers what the app's screens show. The first Windows app (windows/Simpl) stays as it was. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Simpl</RootNamespace>
    <AssemblyName>Simpl</AssemblyName>
    <ApplicationIcon>Assets\Simpl.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Simpl.Program</StartupObject>
    <Product>Simpl</Product>
    <Company>Simpl Courses</Company>
    <Description>Simpl for Windows</Description>
    <Version>0.3.6</Version>
    <FileVersion>0.3.6.1</FileVersion>
    <InformationalVersion>0.3.6</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;WPF0001</NoWarn>
    <!-- published for Windows (CI: -r win-x64), precompiled (ReadyToRun) — the app and what it carries: WPF-UI, PDFsharp,
         WebView2's — so less is compiled as it starts; a build for no runtime in particular (dotnet build) is as before -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <!-- Windows 11's controls for WPF: Mica, the title bar, cards, dialogs, info bars, toggles, Fluent icons -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- PDFs written by the file tools (merge, split, pages turned, marks saved in the file, pictures and text to PDF) -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- Send from Phone's QR code: its modules (MIT); the app draws them itself -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Canvas's formulas typeset from their TeX (MIT; its fonts OFL), drawn as the app's own text: Canvas sends them as
         SVG pictures, which Windows' text cannot show -->
    <PackageReference Include="WpfMath" Version="2.1.0" />
  </ItemGroup>

  <!-- (the models' unit tests, windows/SimplFluent.Tests, reach the tools' internal models) -->
  <ItemGroup>
    <InternalsVisibleTo Include="SimplFluent.Tests" />
  </ItemGroup>

  <!-- (Windows' own APIs as .NET sees them, 25 MB that the file tools alone use: not precompiled, or it more than doubles) -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Simpl.ico" />
    <Resource Include="Assets\Simpl-256.png" />
    <!-- the themes' drawn scenes (the Mac's asset catalogue's): masks, inked in the accent where they show -->
    <Resource Include="Assets\Themes\*.png" />
    <!-- the page Send from Phone serves to the phone (the Mac app carries the same file) -->
    <EmbeddedResource Include="Assets\PhoneHandIn.html" LogicalName="PhoneHandIn.html" />
  </ItemGroup>

  <!-- The extension the engine runs (the same files the Mac and iPhone apps carry), and the bridge and sign-in reader
       the apps share — beside the app, as loose files. -->
  <ItemGroup>
    <None Include="..\..\extension\**\*" Exclude="..\..\extension\**\.DS_Store" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\ios\SimplCourses\Web\bridge.js" Link="Web\bridge.js" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\ios\SimplCourses\Web\login.js" Link="Web\login.js" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Assets\Simpl-256.png" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
