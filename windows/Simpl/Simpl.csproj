<Project Sdk="Microsoft.NET.Sdk">

  <!-- Simpl for Windows: the Mac app's Windows twin (mac/Simpl). As there, the student's Canvas runs in a web view
       underneath (WebView2, with the extension's own scripts in it) and answers what the app's own screens show. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Simpl</RootNamespace>
    <AssemblyName>Simpl</AssemblyName>
    <ApplicationIcon>Assets\Simpl.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Simpl</Product>
    <Company>Simpl Courses</Company>
    <Description>Simpl for Windows</Description>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.1</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- (WPF's own usings: no System.Windows.Forms nor System.Drawing to clash with it) -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Direct3D 11, Direct2D, DirectWrite and the shader compiler: the window is drawn by Simpl's own renderer, with
         Simpl's glass (windows/Shared/Glass.hlsl, the showcase's own) -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Shared\Glass.hlsl" Link="Graphics\Glass.hlsl" LogicalName="Simpl.Glass.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Simpl.ico" />
    <Resource Include="Assets\Simpl-256.png" />
  </ItemGroup>

  <!-- The extension the engine runs (the same files the Mac and iPhone apps carry), and the bridge and sign-in reader
       the apps share — beside the app, as loose files. -->
  <ItemGroup>
    <None Include="..\..\extension\**\*" Exclude="..\..\extension\**\.DS_Store" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\ios\SimplCourses\Web\bridge.js" Link="Web\bridge.js" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\ios\SimplCourses\Web\login.js" Link="Web\login.js" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
