<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- (1.3.184) Sync's Apple Calendar account: this Mac's calendars, read and written through EventKit (the hardened
	     runtime gives an app the Calendars database only with this; macOS still asks the student first) -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
