{
  // (2.99.110) The site on Cloudflare Pages: a Worker of its own that only keeps Simpl's calendars — the FeedStore Durable
  // Object (src/feed-store.js), which a Pages project cannot define itself. The Pages project binds it as FEEDS (Settings →
  // Bindings → Durable Object namespace) and its Functions (functions/api/feed*) answer /api/feed with src/feed.js.
  // Deployed from the site branch: Workers & Pages → Create → Workers → Import a repository, the Worker named
  // simpl-feeds, deploy command `npx wrangler deploy -c feeds.jsonc` (README.md, "Simpl calendars on Pages").
  // On the Workers path (wrangler.jsonc) the site's own Worker defines FeedStore itself, and this one is not needed.
  // (2.99.135) It keeps Hand in from your phone's HandInStore too (src/handin-store.js), from a migration of its own
  // after "feeds-v1": the Pages project binds it as HANDIN the same way (README.md, "Hand in from your phone").
  "name": "simpl-feeds",
  "main": "src/feeds-worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "FEEDS", "class_name": "FeedStore" },
      { "name": "HANDIN", "class_name": "HandInStore" }
    ]
  },
  "migrations": [
    { "tag": "feeds-v1", "new_sqlite_classes": ["FeedStore"] },
    { "tag": "handin-v1", "new_sqlite_classes": ["HandInStore"] }
  ]
}
