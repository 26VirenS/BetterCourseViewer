{
  "manifest_version": 3,
  "name": "Simpl Courses",
  "version": "2.98.19",
  "description": "Canvas with navigation that actually makes sense and a UI that you can actually use.",
  "author": "Simpl Courses contributors",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "Simpl Courses",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "32": "icons/toolbar-32.png",
      "38": "icons/toolbar-38.png",
      "48": "icons/toolbar-48.png",
      "64": "icons/toolbar-64.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/settings.js",
      "lib/devcode.js",
      "content/app/lazy-modules.js",
      "background.js"
    ],
    "persistent": false
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.instructure.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/ocr/reader.html",
        "lib/vendor/pdf.worker.min.js",
        "lib/vendor/katex/fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "lib/settings.js",
        "lib/theme.js",
        "content/early.js"
      ],
      "css": [
        "content/styles/app.css"
      ]
    },
    {
      "matches": [
        "*://*.instructure.com/*"
      ],
      "run_at": "document_end",
      "js": [
        "lib/utils.js",
        "lib/errors.js",
        "lib/record-csv.js",
        "lib/canvas-api.js",
        "content/app/icons.js",
        "content/app/motion.js",
        "content/app/ui.js",
        "content/app/store.js",
        "content/app/lazy-modules.js",
        "content/app/lazy.js",
        "content/app/search.js",
        "content/app/preview.js",
        "content/app/viewer.js",
        "content/app/exttool.js",
        "content/app/screens/native.js",
        "content/app/screens/dashboard.js",
        "content/app/screens/courses.js",
        "content/app/screens/todo.js",
        "content/app/screens/notifications.js",
        "content/app/screens/groups.js",
        "content/app/screens/calendar.js",
        "content/app/screens/inbox.js",
        "content/app/screens/group.js",
        "content/app/screens/course.js",
        "content/app/screens/course-detail.js",
        "content/app/screens/grades.js",
        "content/app/screens/gpa.js",
        "content/app/tools/calc-latex.js",
        "content/app/tools/tools.js",
        "content/app/screens/tools.js",
        "content/app/whatsnew.js",
        "content/app/welcome.js",
        "content/app/extras.js",
        "content/app/app.js"
      ]
    },
    {
      "matches": [
        "https://lazy.simplcourses.invalid/*"
      ],
      "run_at": "document_end",
      "js": [
        "content/app/quiz-page.js",
        "content/app/screens/quiz.js",
        "content/app/screens/submit.js",
        "content/app/screens/feedback.js",
        "content/app/hub.js",
        "content/app/tools/widgets.js",
        "content/app/tools/widget-starters.js",
        "content/app/tools/cite.js",
        "content/app/tools/cards.js",
        "content/app/tools/convert.js",
        "content/app/tools/need.js",
        "content/app/tools/pdfs.js",
        "content/app/tools/mark.js",
        "content/app/tools/ocr.js",
        "content/app/tools/ptable-data.js",
        "content/app/tools/ptable.js",
        "setup/setup-css.js",
        "content/app/personalize.js",
        "content/app/setup.js",
        "content/app/whatsnew-notes.js",
        "content/app/phone.js"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "exclude_matches": [
        "*://*.instructure.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "content/sniff.js"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "run_at": "document_start",
      "js": [
        "content/toolbar.js"
      ]
    }
  ]
}
