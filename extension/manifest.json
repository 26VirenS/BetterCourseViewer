{
  "manifest_version": 3,
  "name": "BetterCourseViewer",
  "version": "2.0.0",
  "description": "A new interface for Canvas: dashboard, courses, to do, calendar, inbox and every course tab redrawn, with a dark appearance and a smart panel powered by your own Claude or ChatGPT key.",
  "author": "BetterCourseViewer contributors",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "action": {
    "default_title": "BetterCourseViewer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "lib/settings.js",
      "lib/providers.js",
      "background.js"
    ],
    "persistent": false
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.instructure.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*"
      ],
      "run_at": "document_start",
      "js": [
        "lib/settings.js",
        "content/early.js"
      ],
      "css": [
        "content/styles/app.css"
      ]
    },
    {
      "matches": [
        "*://*.instructure.com/*"
      ],
      "run_at": "document_end",
      "js": [
        "lib/utils.js",
        "lib/markdown.js",
        "lib/canvas-api.js",
        "lib/smart-client.js",
        "content/app/icons.js",
        "content/app/ui.js",
        "content/app/store.js",
        "content/app/screens/native.js",
        "content/app/screens/dashboard.js",
        "content/app/screens/courses.js",
        "content/app/screens/todo.js",
        "content/app/screens/groups.js",
        "content/app/screens/calendar.js",
        "content/app/screens/inbox.js",
        "content/app/screens/group.js",
        "content/app/screens/course.js",
        "content/app/screens/course-detail.js",
        "content/app/screens/grades.js",
        "content/app/smart.js",
        "content/app/app.js"
      ]
    }
  ]
}
