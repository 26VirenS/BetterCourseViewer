     "min": 0,
     "step": 1
    },
    {
     "id": "tip",
     "kind": "number",
     "label": "Tip",
     "unit": "%",
     "default": 18,
     "min": 0,
     "max": 100,
     "step": 1
    },
    {
     "id": "people",
     "kind": "number",
     "label": "People",
     "unit": "",
     "default": 3,
     "min": 1,
     "max": 100,
     "step": 1
    },
    {
     "id": "roundup",
     "kind": "toggle",
     "label": "Round each share up",
     "default": false
    }
   ],
   "outputs": [
    {
     "id": "each",
     "label": "Each pays",
     "value": "roundup ? ceil(bill * (1 + tip / 100) / floor(people)) : bill * (1 + tip / 100) / floor(people)",
     "unit": "",
     "decimals": 2
    },
    {
     "label": "Tip",
     "value": "bill * tip / 100",
     "unit": "",
     "decimals": 2
    },
    {
     "label": "Total",
     "value": "bill * (1 + tip / 100)",
     "unit": "",
     "decimals": 2
    },
    {
     "label": "Paid in all",
     "value": "each * floor(people)",
     "unit": "",
     "decimals": 2,
     "when": "roundup"
    },
    {
     "label": "Tip with rounding",
     "value": "(each * floor(people) - bill) / bill * 100",
     "unit": "%",
     "decimals": 1,
     "when": "roundup"
    }
   ],
   "note": "Rounding up makes each share a whole amount; what it adds goes to the tip.",
   "created": "2026-11-01"
  },
  {
   "format": 1,
   "id": "s-compound",
   "version": 1,
   "name": "Compound Interest",
   "maker": "Simpl",
   "summary": "Savings growing with interest, and money added monthly.",
   "group": "money",
   "symbol": "chart",
   "color": "#30b0c7",
   "inputs": [
    {
     "id": "p",
     "kind": "number",
     "label": "Starting amount",
     "unit": "",
     "default": 1000,
     "min": 0,
     "step": 100
    },
    {
     "id": "rate",
     "kind": "number",
     "label": "Interest a year",
     "unit": "%",
     "default": 5,
     "min": 0,
     "max": 100,
     "step": 0.25
    },
    {
     "id": "years",
     "kind": "number",
     "label": "Years",
     "unit": "",
     "default": 10,
     "min": 0,
     "max": 100,
     "step": 1
    },
    {
     "id": "n",
     "kind": "choice",
     "label": "Compounded",
     "options": [
      {
       "label": "Yearly",
       "value": 1
      },
      {
       "label": "Quarterly",
       "value": 4
      },
      {
       "label": "Monthly",
       "value": 12
      },
      {
       "label": "Daily",
       "value": 365
      }
     ],
     "default": 12
    },
    {
     "id": "add",
     "kind": "number",
     "label": "Added each month",
     "unit": "",
     "default": 0,
     "min": 0,
     "step": 10
    }
   ],
   "outputs": [
    {
     "id": "bal",
     "label": "Balance",
     "value": "p * (1 + rate / 100 / n) ^ (n * years) + (rate == 0 ? add * 12 * years : add * ((1 + rate / 100 / n) ^ (n * years) - 1) / ((1 + rate / 100 / n) ^ (n / 12) - 1))",
     "unit": "",
     "decimals": 2
    },
    {
     "id": "put",
     "label": "Put in",
     "value": "p + add * 12 * years",
     "unit": "",
     "decimals": 2
    },
    {
     "label": "Interest earned",
     "value": "bal - put",
     "unit": "",
     "decimals": 2
    },
    {
     "label": "Doubling time",
     "value": "ln(2) / (n * ln(1 + rate / 100 / n))",
     "unit": "years",
     "decimals": 1,
     "when": "rate > 0"
    }
   ],
   "note": "Money added goes in at the end of each month. No taxes or fees are counted.",
   "created": "2026-11-01"
  },
