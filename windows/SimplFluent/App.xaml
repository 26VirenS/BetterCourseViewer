<Application x:Class="Simpl.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- Windows 11's look for every control the app shows (WPF-UI): the theme (light or dark, swapped at run time by
         Appearance) and the controls' own styles. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Kit/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="TextFace">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="DisplayFace">Segoe UI Variable Display, Segoe UI</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
