  {
   "format": 1,
   "id": "s-ohms",
   "version": 1,
   "name": "Ohm’s Law",
   "maker": "Simpl",
   "summary": "Any two of volts, amps and ohms give the third.",
   "group": "science",
   "symbol": "bolt",
   "color": "#ff9500",
   "inputs": [
    {
     "id": "find",
     "kind": "choice",
     "label": "Find",
     "options": [
      {
       "label": "Current",
       "value": 1
      },
      {
       "label": "Voltage",
       "value": 2
      },
      {
       "label": "Resistance",
       "value": 3
      }
     ],
     "default": 1
    },
    {
     "id": "v",
     "kind": "number",
     "label": "Voltage",
     "unit": "V",
     "default": 12,
     "min": 0,
     "step": 0.5
    },
    {
     "id": "i",
     "kind": "number",
     "label": "Current",
     "unit": "A",
     "default": 2,
     "min": 0,
     "step": 0.1
    },
    {
     "id": "r",
     "kind": "number",
     "label": "Resistance",
     "unit": "Ω",
     "default": 6,
     "min": 0,
     "step": 1
    }
   ],
   "outputs": [
    {
     "id": "amps",
     "label": "Current",
     "value": "find == 1 ? v / r : i",
     "unit": "A",
     "decimals": 4,
     "when": "find == 1"
    },
    {
     "id": "volts",
     "label": "Voltage",
     "value": "find == 2 ? i * r : v",
     "unit": "V",
     "decimals": 4,
     "when": "find == 2"
    },
    {
     "label": "Resistance",
     "value": "find == 3 ? v / i : r",
     "unit": "Ω",
     "decimals": 4,
     "when": "find == 3"
    },
    {
     "label": "Power",
     "value": "volts * amps",
     "unit": "W",
     "decimals": 3
    }
   ],
   "note": "V = I × R, and the power P = V × I. Choose what to find; the other two boxes are what you know.",
   "created": "2026-11-01"
  },
  {
   "format": 1,
   "id": "s-quadratic",
   "version": 1,
   "name": "Quadratic Formula",
   "maker": "Simpl",
   "summary": "Solve ax² + bx + c = 0: its real roots and vertex.",
   "group": "math",
   "symbol": "function",
   "color": "#5e5ce6",
   "inputs": [
    {
     "id": "a",
     "kind": "number",
     "label": "a",
     "unit": "",
     "default": 1,
     "step": 1
    },
    {
     "id": "b",
     "kind": "number",
     "label": "b",
     "unit": "",
     "default": -3,
     "step": 1
    },
    {
     "id": "c",
     "kind": "number",
     "label": "c",
     "unit": "",
     "default": 2,
     "step": 1
    }
   ],
   "outputs": [
    {
     "label": "x₁",
     "value": "a == 0 ? -c / b : (-b + sqrt(b^2 - 4*a*c)) / (2*a)",
     "unit": "",
     "decimals": 4
    },
    {
     "label": "x₂",
     "value": "(-b - sqrt(b^2 - 4*a*c)) / (2*a)",
     "unit": "",
     "decimals": 4,
     "when": "a != 0"
    },
    {
     "id": "disc",
     "label": "Discriminant",
     "value": "b^2 - 4*a*c",
     "unit": "",
     "decimals": 4
    },
    {
     "label": "Real roots",
     "value": "a == 0 ? (b != 0 ? 1 : 0) : disc > 0 ? 2 : disc == 0 ? 1 : 0",
     "unit": "",
     "decimals": 0
    },
    {
     "label": "Vertex x",
     "value": "-b / (2*a)",
     "unit": "",
     "decimals": 4,
     "when": "a != 0"
    },
    {
     "label": "Vertex y",
     "value": "c - b^2 / (4*a)",
     "unit": "",
     "decimals": 4,
     "when": "a != 0"
    }
   ],
   "note": "x = (−b ± √(b² − 4ac)) / 2a. With no real roots (a negative discriminant) the roots show “—”. With a = 0 it is the line bx + c = 0.",
   "created": "2026-11-01"
  },
  {
   "format": 1,
   "id": "s-percent",
   "version": 1,
   "name": "Percent Change",
   "maker": "Simpl",
   "summary": "How much something went up or down, in percent.",
   "group": "math",
   "symbol": "percent",
   "color": "#ff375f",
   "inputs": [
    {
     "id": "from",
     "kind": "number",
     "label": "Old value",
     "unit": "",
     "default": 80,
     "step": 1
    },
    {
     "id": "to",
     "kind": "number",
     "label": "New value",
     "unit": "",
     "default": 100,
     "step": 1
    }
   ],
   "outputs": [
    {
     "label": "Change",
     "value": "(to - from) / abs(from) * 100",
     "unit": "%",
     "decimals": 2
    },
    {
     "label": "Difference",
     "value": "to - from",
     "unit": "",
     "decimals": 4
    },
    {
     "label": "New as a share of old",
     "value": "to / from * 100",
     "unit": "%",
     "decimals": 2
    }
   ],
   "note": "Change = (new − old) ÷ old × 100. Below zero is a drop. From 0 there is no percent change.",
   "created": "2026-11-01"
  },
  {
   "format": 1,
   "id": "s-tip",
   "version": 1,
   "name": "Tip & Split",
   "maker": "Simpl",
   "summary": "The tip, the total, and what each person pays.",
   "group": "everyday",
   "symbol": "money",
   "color": "#34c759",
   "inputs": [
    {
     "id": "bill",
     "kind": "number",
     "label": "Bill",
     "unit": "",
