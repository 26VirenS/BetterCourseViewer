<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Simpl's type and surfaces (the Mac's Design.swift): its type scale, a little larger than Windows' own, in Segoe UI
       Variable (Windows 11's own face; Segoe UI before it); cards lifted off a quiet page; glass for what floats. -->

  <FontFamily x:Key="Face">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFace">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="Symbols">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Style x:Key="T" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Face}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
  <Style x:Key="LargeTitle" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFace}" />
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Title" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFace}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Title2" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFace}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style x:Key="Title3" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Headline" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Body" TargetType="TextBlock" BasedOn="{StaticResource T}" />
  <Style x:Key="Callout" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style x:Key="Subheadline" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Footnote" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style x:Key="Secondary" TargetType="TextBlock" BasedOn="{StaticResource Callout}">
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource T}">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Symbols}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- A card: a rounded surface lifted off the page by a soft shadow and a hairline. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.07" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Glass (until the Liquid Glass renderer): a light veil over what is behind, a bright hairline where light catches it. -->
  <Style x:Key="GlassCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Glass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdge}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.12" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons: glass capsules; the prominent one in the accent. Pressed, a little smaller (feedback on press, not release). -->
  <Style x:Key="GlassButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Face}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Background" Value="{DynamicResource Glass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeStrong}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1" /></Setter.Value></Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="999" />
            <Border x:Name="Hover" Background="{DynamicResource Well}" CornerRadius="999" Opacity="0" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.96" Duration="0:0:0.09" />
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.96" Duration="0:0:0.09" />
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ProminentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- An icon button in the toolbar: a round glass well on hover. -->
  <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <!-- A plain row button: the whole row presses, a well on hover. -->
  <Style x:Key="RowButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Well}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource WellStrong}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The sidebar's rows: a rounded selection, the row's glyph and words. -->
  <Style x:Key="SidebarItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="0,1">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Well}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SidebarSelected}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A text field in a capsule (the toolbar's search, a filter). -->
  <Style x:Key="FieldBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Face}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scroll bars: thin, quiet, wider under the pointer (as the Mac's overlay scrollers). -->
  <Style x:Key="ThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="4" Background="{DynamicResource WellStrong}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,4">
            <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Margin="4,1">
                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" /></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource Face}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="Background" Value="{DynamicResource Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeStrong}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
</ResourceDictionary>
